# Activates this folder's venv on cd, and deactivates it on the way out.
# Needs direnv installed, plus "direnv allow" once in this folder.
if [ -d venv ]; then
  export VIRTUAL_ENV="$PWD/venv"
  PATH_add "$VIRTUAL_ENV/bin"
else
  echo "direnv: venv/ not found. Run: python3 -m venv venv && pip install -r requirements.txt"
fi
